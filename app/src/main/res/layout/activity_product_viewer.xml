<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/viewerTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:paddingHorizontal="24dp"
        android:paddingVertical="18dp"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="84dp"
        android:background="#66000000"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="@string/viewer_hint"
        android:textColor="#D8C6E0"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnPrevProduct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_experience_button"
        android:drawableStart="@drawable/ic_skip_previous_black_24dp"
        android:drawableTint="#FFFFFF"
        android:drawablePadding="10dp"
        android:paddingHorizontal="30dp"
        android:paddingVertical="20dp"
        android:text="@string/previous_product"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textAllCaps="false"
        android:elevation="10dp" />

    <Button
        android:id="@+id/btnNextProduct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_experience_button"
        android:drawableEnd="@drawable/ic_skip_next_black_24dp"
        android:drawableTint="#FFFFFF"
        android:drawablePadding="10dp"
        android:paddingHorizontal="30dp"
        android:paddingVertical="20dp"
        android:text="@string/next_product"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textAllCaps="false"
        android:elevation="10dp" />

    <Button
        android:id="@+id/btnExitProduct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_exit_red"
        android:paddingHorizontal="44dp"
        android:paddingVertical="16dp"
        android:text="@string/exit_scene_short"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textAllCaps="true"
        android:letterSpacing="0.12"
        android:elevation="10dp" />
</FrameLayout>
