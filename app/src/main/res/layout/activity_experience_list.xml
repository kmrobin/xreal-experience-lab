<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_hub_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="52dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_exit_button"
            android:drawableStart="@drawable/ic_arrow_back"
            android:drawablePadding="8dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp"
            android:text="@string/nav_back"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:elevation="6dp" />

        <TextView
            android:id="@+id/listEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.2"
            android:textAllCaps="true"
            android:textColor="#C79BD1"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:ignore="MissingPrefix" />

        <TextView
            android:id="@+id/listTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/listSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#B9A7C2"
            android:textSize="15sp" />

        <Button
            android:id="@+id/browseGalleryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_experience_button"
            android:paddingVertical="16dp"
            android:text="@string/browse_gallery"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:elevation="6dp"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="28dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp"
        android:scrollbars="none" />

    <Button
        android:id="@+id/bottomBackButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_exit_button"
        android:drawableStart="@drawable/ic_arrow_back"
        android:drawablePadding="8dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:text="@string/nav_back"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textAllCaps="false"
        android:elevation="6dp"
        android:visibility="gone" />
</LinearLayout>
